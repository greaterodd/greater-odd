---
import { CONTACT } from '../data/contact';
import ArrowIcon from './ArrowIcon.astro';
---

<section class="sec work" id="work">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="stamp">GO·02</span>
        <div>
          <p class="eyebrow"><span class="mark"></span>Work</p>
          <h2 class="sec-title">What We Do</h2>
          <p class="sec-note">Two rooms, one lab: build things that work, then break the rules to find what's next.</p>
        </div>
      </div>
      <div class="work-grid">
        <article class="work-card reveal">
          <p class="work-eyebrow">Development</p>
          <h3 class="work-name">Build</h3>
          <p class="body">We build robust, scalable solutions that not only work flawlessly but also provide exceptional user experiences.</p>
          <div class="chips">
            <span class="chip"><b>Web Applications</b></span>
            <span class="chip"><b>Mobile Apps</b></span>
            <span class="chip"><b>API Integration</b></span>
            <span class="chip"><b>Performance Optimization</b></span>
          </div>
          <a class="btn btn-ghost btn-arrow" href="#capabilities">Explore Capabilities
            <ArrowIcon />
          </a>
        </article>
        <article class="work-card reveal">
          <p class="work-eyebrow">Innovation Lab</p>
          <h3 class="work-name">Push</h3>
          <p class="body">Our experimental playground where we explore emerging technologies and push the boundaries of what's possible.</p>
          <div class="chips">
            <span class="chip"><b>Prototype Development</b></span>
            <span class="chip"><b>AI Integration</b></span>
            <span class="chip"><b>Emerging Tech</b></span>
            <span class="chip"><b>R&amp;D Projects</b></span>
          </div>
          <a class="btn btn-ghost btn-arrow" href="#contact">Bring Us An Idea
            <ArrowIcon />
          </a>
        </article>
        <article class="work-card reveal">
          <p class="work-eyebrow">Get in Touch</p>
          <h3 class="work-name">Reach Us</h3>
          <p class="body">A specific project in mind, or just exploring possibilities — we're here to listen and help you navigate the path forward.</p>
          <ul class="work-contact">
            <li><b>Email</b> — {CONTACT.email}</li>
            <li><b>Phone</b> — {CONTACT.phone}</li>
            <li><b>Location</b> — {CONTACT.location}</li>
          </ul>
          <a class="btn btn-ghost btn-arrow" href={CONTACT.emailHref}>Email Us
            <ArrowIcon />
          </a>
        </article>
      </div>
    </div>
  </section>
