---
import { CONTACT } from '../data/contact';
import ArrowIcon from './ArrowIcon.astro';
---
<section class="sec cta" id="contact">
    <div class="wrap cta-in reveal">
      <span class="stamp">GO·06</span>
      <p class="eyebrow"><span class="mark"></span>Get in Touch</p>
      <h2 class="sec-title">Let's Build Something Odd</h2>
      <p>Whether you have a specific project in mind or just want to explore possibilities, we're here to listen and help you navigate the path forward.</p>
      <div class="cta-channels">
        <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        <span>{CONTACT.location}</span>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary btn-arrow" href={CONTACT.emailHref}>Start a Project
          <ArrowIcon />
        </a>
      </div>
    </div>
  </section>
