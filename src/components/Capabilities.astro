<section class="sec" id="capabilities">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="code">GO·03</span>
        <div>
          <p class="eyebrow"><span class="mark"></span>Capabilities · 01—06</p>
          <h2 class="sec-title" style="margin-top:16px">Six Disciplines, One Lab</h2>
        </div>
      </div>
      <div class="feat-grid">
        <article class="feat reveal">
          <div class="feat-num">01</div>
          <h3>Robust Builds</h3>
          <p class="desc">Scalable backends and APIs that hold up in production — no surprises, no shortcuts.</p>
          <div class="feat-well">
            <p class="pcaption">The stack</p>
            <div class="mono tree">
              <span><b>apps/</b>&nbsp; services</span>
              <span><b>api/</b>&nbsp;&nbsp;&nbsp; contracts</span>
              <span><b>tests/</b>&nbsp; guardrails</span>
            </div>
          </div>
        </article>
        <article class="feat reveal">
          <div class="feat-num">02</div>
          <h3>Interfaces That Perform</h3>
          <p class="desc">Fast, accessible web applications and sites — engineered around how people actually use them.</p>
          <div class="feat-well">
            <p class="pcaption">A ship-ready surface</p>
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><span class="url">greaterodd.com</span></div>
              <div class="browser-body"><i></i><i></i><i></i><i></i></div>
            </div>
          </div>
        </article>
        <article class="feat reveal">
          <div class="feat-num">03</div>
          <h3>Native &amp; Cross-Platform</h3>
          <p class="desc">Mobile apps built to feel native on every device, from prototype to store-ready release.</p>
          <div class="feat-well">
            <p class="pcaption">On every pocket</p>
            <div class="phone">
              <i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
          </div>
        </article>
        <article class="feat reveal">
          <div class="feat-num">04</div>
          <h3>Assisted Solutions</h3>
          <p class="desc">LLM-assisted features, agents, and copilots — stitched into products that already ship.</p>
          <div class="feat-well">
            <p class="pcaption">The lab thinks in prompts</p>
            <div class="mono prompt">
              <span class="p">&gt;</span> design an interface that explains itself<br/>
              <span class="p">&gt;</span> shipped, measured, iterated
            </div>
          </div>
        </article>
        <article class="feat reveal">
          <div class="feat-num">05</div>
          <h3>Tooling Developers Keep</h3>
          <p class="desc">Command-line tools and internal automation that make hard workflows feel like one command.</p>
          <div class="feat-well">
            <p class="pcaption">At the terminal</p>
            <div class="checklist">
              <span><b class="ok">✓</b> Automation scripts</span>
              <span><b class="ok">✓</b> Developer tooling</span>
              <span><b class="ok">✓</b> CI pipelines</span>
            </div>
          </div>
        </article>
        <article class="feat reveal">
          <div class="feat-num">06</div>
          <h3>Pushing Limits</h3>
          <p class="desc">Prototypes and experiments on emerging tech — where we fail fast and learn what's next.</p>
          <div class="feat-well">
            <p class="pcaption">Always exploring</p>
            <div class="chips">
              <span class="chip"><b>Prototypes</b></span>
              <span class="chip"><b>Emerging Tech</b></span>
              <span class="chip"><b>Research</b></span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
