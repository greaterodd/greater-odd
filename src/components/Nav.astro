---
import { CONTACT } from '../data/contact';
---
<header class="relative z-40 border-b border-line">
  <div class="wrap grid grid-cols-[1fr_auto_1fr] items-center gap-6 py-5 max-[860px]:grid-cols-[auto_1fr] max-[860px]:py-3.5">
    <nav class="flex justify-start gap-[34px]" aria-label="Primary">
      <a href="#work" class="always border-b border-transparent py-[14px] font-mono text-xs font-bold uppercase tracking-[0.16em] text-fg-dim transition-colors duration-control ease-brand hover:border-fg hover:text-fg">Work</a>
      <a href="#capabilities" class="always border-b border-transparent py-[14px] font-mono text-xs font-bold uppercase tracking-[0.16em] text-fg-dim transition-colors duration-control ease-brand hover:border-fg hover:text-fg">Capabilities</a>
      <a href="#method" class="border-b border-transparent py-[14px] font-mono text-xs font-bold uppercase tracking-[0.16em] text-fg-dim transition-colors duration-control ease-brand hover:border-fg hover:text-fg max-[860px]:hidden">Method</a>
    </nav>
    <a href="#top" class="whitespace-nowrap text-center font-display text-[19px] uppercase tracking-[0.14em] text-fg transition-opacity duration-hover ease-brand hover:opacity-[0.82] max-[860px]:justify-self-start">Greater <em>Odd</em></a>
    <nav class="flex justify-end gap-[34px]" aria-label="Secondary">
      <a href="#contact" class="border-b border-transparent py-[14px] font-mono text-xs font-bold uppercase tracking-[0.16em] text-fg-dim transition-colors duration-control ease-brand hover:border-fg hover:text-fg max-[860px]:hidden">Contact</a>
      <a href={CONTACT.emailHref} class="always border-b border-fg py-[14px] font-mono text-xs font-bold uppercase tracking-[0.16em] text-fg transition-colors duration-control ease-brand">Start a Project</a>
    </nav>
  </div>
</header>
