        <div class="reveal delay-[210ms] border-t border-line-strong pt-[26px]">
          <div class="font-display text-[44px] leading-none tracking-[0.02em] text-fg">04</div>
          <h3 class="mt-4 mb-3 font-display text-[20px] uppercase leading-[1.1] tracking-[0.02em]">Push</h3>
          <p class="text-sm leading-[1.6] text-fg-dim">Ship, measure, iterate — then take the next idea into the lab and push limits.</p>
