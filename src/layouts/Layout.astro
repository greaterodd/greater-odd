---
import '../styles/global.css';
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Greater Odd — Independent Innovation Lab · LatAm',
	description = 'Greater Odd is an independent innovation lab from Latin America. We turn ideas into extraordinary experiences — software, web, AI-assisted solutions, and CLI tooling that push limits.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="oklch(0.42 0.20 258)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
        document.documentElement.classList.add('js');
    </script>
</head>
<body class="overflow-x-hidden bg-blue font-mono text-base leading-[1.55] text-fg antialiased">
    <a class="fixed left-[-9999px] top-3 z-[300] bg-paper px-[18px] py-[14px] font-mono text-xs font-bold leading-none uppercase tracking-[0.14em] text-ink focus:left-3" href="#top">Skip to content</a>
    <div class="pointer-events-none fixed inset-3 z-[220] border border-white/10" aria-hidden="true">
        <i class="absolute -left-px -top-px block h-[22px] w-[22px] border-l border-t border-white/35"></i>
        <i class="absolute -bottom-px -right-px block h-[22px] w-[22px] border-b border-r border-white/35"></i>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <div class="pointer-events-none fixed top-1/2 left-2.5 z-[218] hidden -translate-y-1/2 rotate-90 whitespace-nowrap font-mono text-[10px] font-bold uppercase tracking-[0.42em] text-white/[0.42] xl:block" aria-hidden="true">Greater Odd · Innovation Lab · Latam</div>
    <div class="pointer-events-none fixed top-1/2 right-2.5 z-[218] hidden -translate-y-1/2 -rotate-90 whitespace-nowrap font-mono text-[10px] font-bold uppercase tracking-[0.42em] text-white/[0.42] xl:block" aria-hidden="true">Pushing Limits · Since 2024</div>
    <slot />

    <script>
        (function () {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            const reveals = document.querySelectorAll('.reveal, .hero .ent');
            if ('IntersectionObserver' in window && !reduceMotion) {
                const io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) {
                            e.target.classList.add('is-in');
                            io.unobserve(e.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
                reveals.forEach(function (el) { io.observe(el); });
            } else {
                reveals.forEach(function (el) { el.classList.add('is-in'); });
            }
        })();
    </script>
</body>
</html>
