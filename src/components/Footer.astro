---
import { CONTACT } from '../data/contact';
---
<footer class="footer">
    <div class="wrap footer-top">
      <div class="footer-brand">
        <p class="foot-word">Greater Odd</p>
        <p>An independent innovation lab from Latin America. We turn ideas into extraordinary experiences.</p>
      </div>
      <div class="foot-col">
        <h4>Studio</h4>
        <a href="#work">Work</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#method">Method</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="foot-col">
        <h4>Capabilities</h4>
        <a href="#capabilities">Software</a>
        <a href="#capabilities">Web</a>
        <a href="#capabilities">AI</a>
        <a href="#capabilities">CLI</a>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <a href={CONTACT.emailHref}>{CONTACT.email}</a>
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a>
        <span>{CONTACT.location}</span>
      </div>
    </div>
    <div class="wrap footer-meta">
      <span>© 2024 Greater Odd · All rights reserved</span>
      <span>Made with passion and precision</span>
      <span>LatAm · Independent</span>
    </div>
    <div class="ghost-wrap">
      <div class="ghost">Greater Odd</div>
    </div>
  </footer>
