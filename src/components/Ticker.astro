---

const items = ['Software', 'Web Applications', 'Mobile Apps', 'API Integration', 'Performance Optimization', 'AI Integration', 'CLI Tooling', 'Prototypes', 'Emerging Tech', 'R&D Projects'];
---

<div class="overflow-hidden border-y border-line" aria-hidden="true">
    <div class="flex w-max animate-tick hover:[animation-play-state:paused] motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:animate-none" data-ticker-track>
      {items.map((t) => (
        <Fragment>
          <span class="whitespace-nowrap py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-fg-dim">{t}</span>
          <span class="whitespace-nowrap py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-fg px-[22px]">·</span>
        </Fragment>
      ))}
      {items.map((t) => (
        <Fragment>
          <span class="motion-reduce:hidden whitespace-nowrap py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-fg-dim">{t}</span>
          <span class="motion-reduce:hidden whitespace-nowrap py-4 font-mono text-xs font-bold uppercase tracking-[0.18em] text-fg px-[22px]">·</span>
        </Fragment>
      ))}
    </div>
  </div>
